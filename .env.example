# Port som containeren og Express-serveren lytter på
PORT=3000

# Primær Mailcow server-vært (skjules i login-billedet i browseren).
# Sætter automatisk IMAP (993), SMTP (465), ManageSieve (4190), CalDAV (/SOGo/dav/) og CardDAV (/SOGo/dav/).
# Eksempel: mail.ditdomæne.dk
DEFAULT_MAIL_HOST=

# Valgfri specifikke overstyringer hvis IMAP, SMTP eller CalDAV/CardDAV ligger på forskellige adresser/porte
DEFAULT_IMAP_HOST=
DEFAULT_IMAP_PORT=993
DEFAULT_IMAP_SECURE=true
DEFAULT_SMTP_HOST=
DEFAULT_SMTP_PORT=465
DEFAULT_SMTP_SECURE=true
DEFAULT_SIEVE_PORT=4190
DEFAULT_CALDAV_URL=

# Aktive moduler i suiten (kommasepareret: mail,calendar,contacts)
APP_MODULES=mail,calendar,contacts

# Valgfrit offentligt link til klassisk SOGo (f.eks. https://mail.ditdomæne.dk/SOGo),
# så brugere frit kan skifte til SOGo fra login-skærmen eller sidepanelet
SOGO_URL=

# Tillad selv-signerede certifikater på intern Mailcow VM (sæt kun til true på lukket LAN)
ALLOW_INSECURE_TLS=false

# Valgfri hemmelig nøgle til AES-256-GCM sessionscookies & delingslinks
# (hvis tom genereres en persistent nøgle automatisk i /app/data/.suite_secret)
SESSION_SECRET=

# Mappe til persistent data (aliaser, delingslinks, kalender-abonnementer, sessionsnøgle)
DATA_DIR=/app/data
